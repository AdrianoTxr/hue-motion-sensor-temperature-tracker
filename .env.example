# Copie ce fichier en .env.local pour le développement local.
# En production, renseigne ces variables dans Vercel (Settings → Environment Variables).
# NE JAMAIS COMMITTER DE VRAIES VALEURS : le dépôt est public.

# Base de données Postgres (Neon). Fournie automatiquement par l'intégration Neon de Vercel.
DATABASE_URL=

# Application créée sur https://developers.meethue.com (Remote Hue API)
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=

# Secret partagé avec cron-job.org (en-tête "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Mot de passe d'accès au site (identifiant libre, seul le mot de passe est vérifié)
APP_PASSWORD=

# Fuseau horaire utilisé pour les vues jour / heure
APP_TIMEZONE=Europe/Paris
